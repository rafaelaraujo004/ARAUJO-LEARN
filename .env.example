# ---------------------------------------------------------------- Aplicação
NODE_ENV=development
# URL pública da aplicação (usada em links de e-mail e validação de certificado)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------- Banco
# Railway: copie a DATABASE_URL do plugin PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/araujo_learn?schema=public

# -------------------------------------------------------------- Autenticação
# Segredo para assinar tokens de sessão/redefinição. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-este-valor-em-producao-com-48-bytes-aleatorios
# Duração da sessão em dias
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- Storage
# s3    -> Railway Storage Bucket (ou qualquer S3-compatível: R2, MinIO, AWS)
# local -> disco local, apenas para desenvolvimento sem credenciais
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=araujo-learn
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Railway/R2/MinIO exigem path-style; AWS S3 não.
S3_FORCE_PATH_STYLE=true
# Validade das URLs assinadas de leitura (segundos)
SIGNED_URL_TTL=900

# ------------------------------------------------------------------ E-mail
# console -> imprime o link no log (padrão sem credenciais)
# smtp    -> usa as variáveis SMTP_* abaixo
MAIL_DRIVER=console
MAIL_FROM="ARAUJO LEARN <nao-responda@araujolearn.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
